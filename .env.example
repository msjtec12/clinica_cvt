# Supabase Configuration
# Preencha com as credenciais do seu projeto Supabase (disponíveis no painel em Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Observação: Se estas variáveis não forem configuradas,
# o site continuará funcionando perfeitamente em modo estático seguro com os dados em src/data/
